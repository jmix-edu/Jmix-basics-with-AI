<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/booking/liquibase/changelog/2026/10/base-model.xml">
    <changeSet id="1" author="booking">
        <createTable tableName="AMENITY">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_AMENITY"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="booking">
        <createTable tableName="BOOKING">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOOKING"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ROOM_ID" type="UUID"/>
            <column name="DESK_ID" type="UUID"/>
            <column name="START_AT" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="END_AT" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="COMMENT_" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="booking">
        <createTable tableName="BUILDING">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BUILDING"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ADDRESS" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="booking">
        <createTable tableName="DESK">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DESK"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="FLOOR_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="5" author="booking">
        <createTable tableName="FLOOR_">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_FLOOR_"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="BUILDING_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="NUMBER_" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>
    <changeSet id="6" author="booking">
        <createTable tableName="ROOM">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ROOM"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="FLOOR_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="CAPACITY" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="7" author="booking">
        <createTable tableName="ROOM_AMENITY_LINK">
            <column name="AMENITY_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ROOM_AMENITY_LINK"/>
            </column>
            <column name="ROOM_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ROOM_AMENITY_LINK"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="8" author="booking">
        <addUniqueConstraint columnNames="FLOOR_ID, CODE" constraintName="UK_DESK_FLOOR_CODE" tableName="DESK"/>
    </changeSet>
    <changeSet id="9" author="booking">
        <addUniqueConstraint columnNames="BUILDING_ID, NUMBER_" constraintName="UK_FLOOR__BUILDING_NUMBER"
                             tableName="FLOOR_"/>
    </changeSet>
    <changeSet id="10" author="booking">
        <addUniqueConstraint columnNames="FLOOR_ID, NAME" constraintName="UK_ROOM_FLOOR_NAME" tableName="ROOM"/>
    </changeSet>
    <changeSet id="11" author="booking">
        <createIndex indexName="IDX_AMENITY_UNQ_NAME" tableName="AMENITY" unique="true">
            <column name="NAME"/>
        </createIndex>
    </changeSet>
    <changeSet id="12" author="booking">
        <createIndex indexName="IDX_BOOKING_DESK_START_AT" tableName="BOOKING">
            <column name="DESK_ID"/>
            <column name="START_AT"/>
        </createIndex>
    </changeSet>
    <changeSet id="13" author="booking">
        <createIndex indexName="IDX_BOOKING_ROOM_START_AT" tableName="BOOKING">
            <column name="ROOM_ID"/>
            <column name="START_AT"/>
        </createIndex>
    </changeSet>
    <changeSet id="14" author="booking">
        <createIndex indexName="IDX_BOOKING_USER" tableName="BOOKING">
            <column name="USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="BOOKING" constraintName="FK_BOOKING_ON_USER"
                                 referencedColumnNames="ID" referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="15" author="booking">
        <createIndex indexName="IDX_BUILDING_UNQ_NAME" tableName="BUILDING" unique="true">
            <column name="NAME"/>
        </createIndex>
    </changeSet>
    <changeSet id="16" author="booking">
        <createIndex indexName="IDX_DESK_FLOOR" tableName="DESK">
            <column name="FLOOR_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="FLOOR_ID" baseTableName="DESK" constraintName="FK_DESK_ON_FLOOR"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="FLOOR_"/>
    </changeSet>
    <changeSet id="17" author="booking">
        <createIndex indexName="IDX_FLOOR__BUILDING" tableName="FLOOR_">
            <column name="BUILDING_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="BUILDING_ID" baseTableName="FLOOR_"
                                 constraintName="FK_FLOOR__ON_BUILDING" onDelete="CASCADE" referencedColumnNames="ID"
                                 referencedTableName="BUILDING"/>
    </changeSet>
    <changeSet id="18" author="booking">
        <createIndex indexName="IDX_ROOM_FLOOR" tableName="ROOM">
            <column name="FLOOR_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="FLOOR_ID" baseTableName="ROOM" constraintName="FK_ROOM_ON_FLOOR"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="FLOOR_"/>
    </changeSet>
    <changeSet id="19" author="booking">
        <addForeignKeyConstraint baseColumnNames="DESK_ID" baseTableName="BOOKING" constraintName="FK_BOOKING_ON_DESK"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="DESK"/>
    </changeSet>
    <changeSet id="20" author="booking">
        <addForeignKeyConstraint baseColumnNames="ROOM_ID" baseTableName="BOOKING" constraintName="FK_BOOKING_ON_ROOM"
                                 onDelete="CASCADE" referencedColumnNames="ID" referencedTableName="ROOM"/>
    </changeSet>
    <changeSet id="21" author="booking">
        <addForeignKeyConstraint baseColumnNames="AMENITY_ID" baseTableName="ROOM_AMENITY_LINK"
                                 constraintName="FK_ROOAME_ON_AMENITY" referencedColumnNames="ID"
                                 referencedTableName="AMENITY"/>
    </changeSet>
    <changeSet id="22" author="booking">
        <addForeignKeyConstraint baseColumnNames="ROOM_ID" baseTableName="ROOM_AMENITY_LINK"
                                 constraintName="FK_ROOAME_ON_ROOM" referencedColumnNames="ID"
                                 referencedTableName="ROOM"/>
    </changeSet>
</databaseChangeLog>