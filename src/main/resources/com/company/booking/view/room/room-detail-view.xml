<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://roomDetailView.title"
      focusComponent="form">
    <data>
        <instance id="roomDc"
                  class="com.company.booking.entity.Room">
            <fetchPlan extends="_base">
                <property name="floor" fetchPlan="_base"/>
                <property name="amenities" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="roomDl"/>
            <collection id="amenitiesDc" property="amenities"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="roomDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <integerField id="capacityField" property="capacity"/>
        </formLayout>
        <h4 text="msg://com.company.booking.entity/Room.amenities"/>
        <hbox id="amenitiesButtonsPanel" wrap="true" width="100%">
            <button action="amenitiesDataGrid.addAction"/>
            <button action="amenitiesDataGrid.excludeAction"/>
        </hbox>
        <dataGrid id="amenitiesDataGrid" dataContainer="amenitiesDc" width="100%" minHeight="20em">
            <actions>
                <action id="addAction" type="list_add"/>
                <action id="excludeAction" type="list_exclude"/>
            </actions>
            <columns>
                <column property="name"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
